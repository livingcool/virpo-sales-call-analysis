# ─── Sales Call Analysis — Environment Variable Template ──────────────────────
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local — it is .gitignore'd.
# The encrypted version (.env.enc) is committed; decrypt with: openssl enc -d -aes-256-cbc -pbkdf2 -in .env.enc -out .env.local

# ─── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhb...your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=eyJhb...your_service_role_key_here

# ─── Sarvam AI (Tamil STT) ────────────────────────────────────────────────────
SARVAM_API_KEY=sk_your_sarvam_key_here

# ─── Google Gemini AI ─────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
